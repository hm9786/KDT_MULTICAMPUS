# 환경 변수 설정 예시 파일
# 이 파일을 복사하여 .env 파일을 만들고 실제 API 키를 입력하세요.
# 
# 사용 방법:
# 1. 이 파일을 .env로 복사: cp .env.example .env (Mac/Linux) 또는 copy .env.example .env (Windows)
# 2. 아래의 your_xxx_here 부분을 실제 API 키로 교체
# 3. .env 파일은 절대 Git에 커밋하지 마세요!

# ============================================
# OpenWeatherMap API Key (필수)
# ============================================
# 날씨 정보 조회에 사용됩니다.
# 발급 사이트: https://openweathermap.org/api
# 무료 플랜: 일일 1,000회 호출 가능
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# ============================================
# 공공데이터포털 API Key (선택사항)
# ============================================
# 공휴일 정보 조회에 사용됩니다.
# 발급 사이트: https://www.data.go.kr
# 공휴일 기능을 사용하지 않으면 설정하지 않아도 됩니다.
VITE_PUBLIC_DATA_API_KEY=your_public_data_api_key_here